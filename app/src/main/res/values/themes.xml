<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Base App Theme: Uses the standard AppCompat theme to ensure the ActionBar is included -->
    <style name="Theme.Welly" parent="Theme.AppCompat.DayNight">
        <item name="colorPrimary">@color/primary_blue</item>
        <item name="colorPrimaryDark">@color/black</item>
        <item name="colorAccent">@color/blue_accent</item>
        <item name="android:windowBackground">@color/background_dark</item>
        <item name="android:textColorPrimary">@color/white</item>
        <item name="colorSurface">@color/card_dark</item>
    </style>

    <!-- 1. DARK THEME (The default dark mode) -->
    <style name="Theme.Welly.Dark" parent="Theme.AppCompat.DayNight">
        <item name="colorPrimary">@color/primary_blue</item>
        <item name="colorPrimaryDark">@color/black</item>
        <item name="colorAccent">@color/blue_accent</item>
        <item name="android:windowBackground">@color/background_dark</item>
        <item name="android:textColorPrimary">@color/white</item>
        <item name="colorSurface">@color/card_dark</item>
    </style>

    <!-- 3. PINK THEME -->
    <style name="Theme.Welly.Pink" parent="Theme.AppCompat.DayNight">
        <item name="colorPrimary">@color/primary_pink</item>
        <item name="colorPrimaryDark">@color/primary_pink</item>
        <item name="colorAccent">@color/pink_accent</item>
        <item name="android:windowBackground">@color/background_dark</item>
        <item name="android:textColorPrimary">@color/white</item>
        <item name="colorSurface">@color/card_dark</item>
    </style>

    <!-- 4. PURPLE THEME -->
    <style name="Theme.Welly.Purple" parent="Theme.AppCompat.DayNight">
        <item name="colorPrimary">@color/primary_purple</item>
        <item name="colorPrimaryDark">@color/primary_purple</item>
        <item name="colorAccent">@color/purple_accent</item>
        <item name="android:windowBackground">@color/background_dark</item>
        <item name="android:textColorPrimary">@color/white</item>
        <item name="colorSurface">@color/card_dark</item>
    </style>

</resources>